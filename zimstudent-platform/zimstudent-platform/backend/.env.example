# Copy to .env for local `supabase functions serve` testing.
# For deployed functions, set these with `supabase secrets set KEY=value` instead.

# Supabase (from your project's API settings)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # never expose this client-side

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5                       # optional override

# WhatsApp Business Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=your-whatsapp-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-any-random-string      # you invent this, used in the webhook handshake

# Deployed function URLs (fill in after first deploy)
DOCUMENT_INGEST_URL=https://YOUR-PROJECT-REF.functions.supabase.co/document-ingest

# Student portal login (OTP delivered over WhatsApp — see send-otp/verify-otp)
STUDENT_TOKEN_SECRET=generate-a-long-random-string-here   # e.g. `openssl rand -hex 32`

# Welfare scan tuning
SILENCE_THRESHOLD_DAYS=60
